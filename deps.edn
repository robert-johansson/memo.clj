{:paths ["src"]

 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        ;; gen.clj pinned to its 1.2 release (memo.clj 1.2 goes with gen.clj
        ;; 1.2). GenGDT depends on both projects
        ;; and its own gen.clj pin wins, so a GenGDT that takes this commit
        ;; must pin the same gen.clj. :dev uses the working copy.
        gen.clj/gen.clj {:git/url "https://github.com/robert-johansson/gen.clj.git"
                         :git/tag "v1.2.0"
                         :git/sha "c0fc80c7e653a2a3b0ec199dbdc2f6bc1cfd0bd6"}}

 :aliases
 {;; clojure -X:test          every test
  ;; clojure -X:test:fast     without the ^:slow tests
  ;; An 8 GB heap whatever the machine's memory (the JVM's default is a
  ;; quarter of it): demo-empowerment needs it on the JVM backend.
  :test {:extra-paths ["test"]
         :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx8g"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      ;; gen.clj's laws, a module of its repository at the same release as
                      ;; the gen.clj pinned above (which wins over the one it brings)
                      gen.clj/laws {:git/url "https://github.com/robert-johansson/gen.clj.git"
                                    :git/tag "v1.2.0"
                                    :git/sha "c0fc80c7e653a2a3b0ec199dbdc2f6bc1cfd0bd6"
                                    :deps/root "ext/laws"}}
         :exec-fn cognitect.test-runner.api/test}
  :fast {:exec-args {:excludes [:slow]}}
  ;; the differential fuzzer (needs memo-mcp's Python memo): clojure -X:test:fuzz :n 2000 :seed 1
  :fuzz {:exec-fn memo.fuzz/cli}

  ;; the speed research's benchmarks (bean memoclj-c0xj): clojure -M:bench -m memo.bench.agent
  :bench {:extra-paths ["bench"]
          :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx8g"]}

  ;; gen.clj's MLX backend (Metal by default): clojure -X:test:mlx
  ;; gen.clj looks for its native library relative to the working directory,
  ;; so another project names it: here a gen.clj checkout beside memo.clj,
  ;; with its native libraries built (gen.clj's native/build-mlx.sh)
  :mlx {:jvm-opts ["-Dgen.backend=mlx"
                   "-Dgen.mlx.lib=../gen.clj/native/build/macos-arm64/lib"
                   "--enable-native-access=ALL-UNNAMED"]}

  ;; gen.clj's working copy instead of the pin, a checkout beside memo.clj:
  ;; clojure -X:dev:test
  :dev {:override-deps {gen.clj/gen.clj {:local/root "../gen.clj"}
                         gen.clj/laws {:local/root "../gen.clj/ext/laws"}}}}}
