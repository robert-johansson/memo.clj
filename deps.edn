{:paths ["src"]

 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        ;; gen.clj pinned to a commit of the local repository, the same pin as
        ;; GenGDT's (GenGDT depends on both projects and tools.deps resolves one
        ;; gen.clj, so move the two pins together). :dev uses the working copy.
        gen.clj/gen.clj {:git/url "file:///Users/robert/code/gen.clj"
                         :git/sha "c152f727ef3aab23906a887c3605fc25587b8080"}}

 :aliases
 {;; clojure -X:test          every test
  ;; clojure -X:test:fast     without the ^:slow tests
  :test {:extra-paths ["test"]
         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :exec-fn cognitect.test-runner.api/test}
  :fast {:exec-args {:excludes [:slow]}}

  ;; gen.clj's MLX backend (Metal by default): clojure -X:test:mlx
  ;; gen.clj looks for its native library relative to the working directory,
  ;; so another project names it
  :mlx {:jvm-opts ["-Dgen.backend=mlx"
                   "-Dgen.mlx.lib=/Users/robert/code/gen.clj/native/build/macos-arm64/lib"
                   "--enable-native-access=ALL-UNNAMED"]}

  ;; gen.clj's working copy instead of the pin: clojure -X:dev:test
  :dev {:override-deps {gen.clj/gen.clj {:local/root "/Users/robert/code/gen.clj"}}}}}
